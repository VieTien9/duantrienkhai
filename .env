# ==========================================
# HRM SYSTEM ENVIRONMENT CONFIGURATION (.env)
# ==========================================

# PostgreSQL Database Configuration
DB_HOST=postgres_db
DB_PORT=5432
DB_NAME=hrm_db
DB_USER=hrm_user
DB_PASSWORD=hrm_secure_password_2026

# Web Application
WEBAPP_PORT=3002
NODE_ENV=production

# Nginx HTTP Port (Tránh trùng cổng 80 của hệ thống)
NGINX_HTTP_PORT=8000

# pgAdmin 4 Configuration
PGADMIN_DEFAULT_EMAIL=admin@hrm.com
PGADMIN_DEFAULT_PASSWORD=Admin@HRM2026!
PGADMIN_PORT=5051

# Grafana Monitoring Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Admin@Grafana2026!
GRAFANA_PORT=3001

# Monitoring & Logging Ports
PROMETHEUS_PORT=9091
CADVISOR_PORT=8085
LOKI_PORT=3100
PROMTAIL_PORT=9080
